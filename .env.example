# ==============================================================================
# TrustLayer — Master Environment Configuration Template
# ==============================================================================
# Copy this template to .env at the project root:
#   cp .env.example .env
#
# TrustLayer's backend automatically loads configuration from both root .env
# and backend/.env. The frontend reads VITE_ variables from frontend/.env or
# defaults cleanly to http://localhost:8000.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Python FastAPI, pgvector, Hugging Face, Gemini)
# ------------------------------------------------------------------------------

# Database connection string (PostgreSQL + pgvector with asyncpg)
# Example Docker: postgresql+asyncpg://postgres:root1234@localhost:5432/trustlayer
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/trustlayer

# Google Gemini API key (used for claim extraction in Module 1; fallback heuristics available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=6

# Hugging Face access token (used for downloading BGE-M3 and DeBERTa-v3 models)
HF_TOKEN=your_huggingface_token_here

# Local cache directory for Hugging Face model weights (defaults to ./models_cache relative to backend)
HF_HOME=./models_cache

# ------------------------------------------------------------------------------
# Frontend Configuration (React 19 + Vite Dashboard)
# ------------------------------------------------------------------------------

# Backend API base URL for client HTTP calls
# In development, Vite's proxy automatically forwards /chat, /approvals, /dashboard,
# /audit, /health, and /users to http://localhost:8000 if omitted or unchanged.
VITE_API_BASE_URL=http://localhost:8000
